<?xml version="1.0" encoding="utf-8"?>
<!-- AppTheme.lightSurface behind Open, outlined so it still reads as a
     control against the cream panel. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_light_surface" />
    <stroke
        android:width="1dp"
        android:color="#33FF5722" />
    <corners android:radius="14dp" />
</shape>
