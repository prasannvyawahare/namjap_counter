<?xml version="1.0" encoding="utf-8"?>
<!-- AppTheme.lightBackground. The hairline keeps the cream panel from
     dissolving into a pale wallpaper. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_light_background" />
    <stroke
        android:width="1dp"
        android:color="#1A20242E" />
    <corners android:radius="@dimen/widget_corner_radius" />
</shape>
