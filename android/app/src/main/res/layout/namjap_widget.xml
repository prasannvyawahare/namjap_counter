<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget. Every value shown here is written by the Flutter side
     via home_widget and read back in NamjapWidgetProvider; the layout itself
     holds no state.

     The colours below are the dark scheme, which is the app's default. The
     provider re-points the backgrounds and text colours at the light set when
     the app's own dark-mode preference is off — the widget follows the app's
     theme, not the system's. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background_dark"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:text="@string/widget_title"
            android:textColor="@color/widget_dark_on_surface_muted"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/widget_dark_on_surface"
        android:textSize="22sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Two bars rather than one: a ProgressBar's progressDrawable cannot be
         swapped through RemoteViews, so the themed pair is built into the
         layout and the provider shows whichever one belongs. -->
    <ProgressBar
        android:id="@+id/widget_progress_dark"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progressDrawable="@drawable/widget_progress_dark" />

    <ProgressBar
        android:id="@+id/widget_progress_light"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:visibility="gone"
        android:progressDrawable="@drawable/widget_progress_light" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_remaining"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widget_dark_on_surface_muted"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_dark_on_surface"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <!-- Open sits left and +1 right, so counting — the thing done over and
             over — falls under the thumb, and is the larger of the two. -->
        <TextView
            android:id="@+id/widget_open"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:background="@drawable/widget_button_surface_dark"
            android:gravity="center"
            android:text="@string/widget_open"
            android:textColor="@color/widget_saffron"
            android:textSize="15sp"
            android:textStyle="bold"
            android:contentDescription="@string/widget_open_description" />

        <TextView
            android:id="@+id/widget_increment"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1.5"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:background="@drawable/widget_button_primary_dark"
            android:gravity="center"
            android:text="@string/widget_increment"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:contentDescription="@string/widget_increment_description" />
    </LinearLayout>
</LinearLayout>
